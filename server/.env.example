# Local development values. For production see docs/DEPLOYMENT.md (the server refuses to start in production with missing or weak settings).
# ---- App ----
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
SESSION_SECRET=change-me-to-a-long-random-string

# Serve the built website from this server too (single-service hosting, e.g. Render). Leave false behind nginx.
SERVE_CLIENT=false

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/perfect_intern

# ---- Private file storage (CVs, photos). Keep OUTSIDE any public web root ----
UPLOAD_DIR=./uploads

# ---- Email ----
# EMAIL_PROVIDER: smtp (default) | brevo | resend. Hosts like Render's free tier BLOCK outbound SMTP, so use brevo or resend there (HTTPS API).
# Leave everything empty in dev to print emails to the console.
EMAIL_PROVIDER=smtp
BREVO_API_KEY=
RESEND_API_KEY=

# SMTP settings (only when EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="The Perfect Intern <no-reply@theperfectintern.co.ke>"
ADMIN_NOTIFY_EMAIL=admin@theperfectintern.co.ke

# ---- Seed accounts (development only) ----
SEED_ADMIN_EMAIL=admin@theperfectintern.co.ke
SEED_ADMIN_PASSWORD=ChangeMe#2026

# ---- M-Pesa Daraja (Phase 6). Never commit real values ----
MPESA_ENV=sandbox                      # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379                 # sandbox Lipa na M-Pesa shortcode
MPESA_PASSKEY=                         # from the Daraja portal (sandbox passkey for the test shortcode)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline   # use CustomerBuyGoodsOnline for a Till number
MPESA_PARTY_B=                         # only for Till numbers: the till number (shortcode stays the store number)
# Public HTTPS base of the callback route, e.g. your ngrok URL + /api/payments/mpesa/callback
MPESA_CALLBACK_URL=https://your-tunnel.example.com/api/payments/mpesa/callback
# Long random string appended to the callback URL as a shared secret (openssl rand -hex 32)
MPESA_CALLBACK_SECRET=
# Optional comma-separated allow-list of Safaricom source IPs. Leave empty in sandbox; set in production.
MPESA_ALLOWED_IPS=
# OFFLINE TESTING ONLY: simulates STK Push without calling Safaricom. Refused when NODE_ENV=production.
MPESA_MOCK=false
